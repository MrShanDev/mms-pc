{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
        "ignoreDeprecations": "5.0",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@stores/*": [
                "./stores/*"
            ],
            "@composables/*": [
                "./app/composables/*"
            ],
            "@utils/*": [
                "./utils/*"
            ]
        }
    }
}